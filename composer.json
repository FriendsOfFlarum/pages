{
    "name": "fof/pages",
    "description": "Create custom pages with Flarum",
    "keywords": [
        "flarum"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "require": {
        "flarum/core": "^2.0.0-beta",
        "ext-json": "*"
    },
    "support": {
        "issues": "https://github.com/FriendsOfFlarum/pages/issues",
        "source": "https://github.com/FriendsOfFlarum/pages",
        "forum": "https://discuss.flarum.org/d/18301"
    },
    "homepage": "https://friendsofflarum.org",
    "funding": [
        {
            "type": "website",
            "url": "https://opencollective.com/fof/donate"
        }
    ],
    "authors": [
        {
            "name": "IanM",
            "email": "ian@flarum.org",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "FoF\\Pages\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "FoF Pages",
            "category": "feature",
            "icon": {
                "name": "far fa-file-alt",
                "backgroundColor": "#e74c3c",
                "color": "#fff"
            }
        },
        "flagrow": {
            "discuss": "https://discuss.flarum.org/d/18301"
        },
        "flarum-cli": {
            "modules": {
                "githubActions": true
            }
        }
    },
    "require-dev": {
        "flarum/phpstan": "^2.0.0-beta",
        "flarum/testing": "^2.0.0-beta"
    },
    "scripts": {
        "analyse:phpstan": "phpstan analyse",
        "clear-cache:phpstan": "phpstan clear-result-cache"
    },
    "scripts-descriptions": {
        "analyse:phpstan": "Run static analysis"
    }
}